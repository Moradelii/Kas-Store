# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# CLOUD SQL POSTGRESQL (Auto-configured in runtime by Google AI Studio)
SQL_HOST="127.0.0.1"
SQL_USER="postgres"
SQL_PASSWORD="your-database-password"
SQL_DB_NAME="postgres"

# ==========================================
# PASARELA DE PAGOS 1: TARJETAS EN HONDURAS (PIXELPAY)
# Proveedor regulado CNBS para comercios en Honduras con liquidación en HNL
# Compatible con BAC Credomatic, Ficohsa, Atlántida, Banpaís
# ==========================================
PIXELPAY_ENV="sandbox" # "sandbox" o "live"
PIXELPAY_KEY="tu_pixelpay_key"
PIXELPAY_SECRET="tu_pixelpay_secret"
PIXELPAY_WEBHOOK_SECRET="tu_pixelpay_webhook_secret"

# ==========================================
# PASARELA DE PAGOS 2: PAYPAL REST API V2
# Cuenta comercial PayPal habilitada para ventas internacionales
# Moneda de liquidación: USD (tasa oficial referencial 25.50 HNL/USD)
# ==========================================
PAYPAL_ENV="sandbox" # "sandbox" o "live"
PAYPAL_CLIENT_ID="tu_paypal_client_id"
PAYPAL_CLIENT_SECRET="tu_paypal_client_secret"
PAYPAL_WEBHOOK_ID="tu_paypal_webhook_id"
